#!/bin/bash

# --- HELPER: Install starship ( Command line ) ---
install_starship() {
    if ! command -v starship &> /dev/null; then
        echo "Installing Starship..."
        curl -sS https://starship.rs/install.sh | sh -s -- -y
    fi
}

# --- HELPER: Install pynvim (Python provider for Neovim) ---
install_pynvim() {
    if command -v uv &> /dev/null; then
        echo "Installing pynvim..."
        uv tool install --upgrade pynvim
    else
        echo "uv not found, skipping pynvim"
    fi
}

# --- HELPER: Install antidote (Zsh plugin manager) ---
install_zshplugins() {
    if [ ! -d "${HOME}/.antidote" ]; then
        echo "Installing Antidote..."
        git clone --depth=1 https://github.com/mattmc3/antidote.git "${HOME}/.antidote"
    fi

	PLUGINS_FILE="${HOME}/.zsh_plugins.txt"
	touch "${PLUGINS_FILE}"
	if ! grep -q "jeffreytse/zsh-vi-mode" "${PLUGINS_FILE}"; then                                       
		 echo "jeffreytse/zsh-vi-mode" >> "${PLUGINS_FILE}"                                              
		 echo "Added jeffreytse/zsh-vi-mode to plugins."                                                 
    fi    
}

{{ if and ( eq .chezmoi.os "darwin") .dev_computer -}}
# ========== MAC OS (Homebrew) ==========
echo "Detecting macOS... updating Homebrew"
if command -v brew &> /dev/null; then
    # List of packages to install via Brew
    packages=(
        "ripgrep"
        "lazygit"
        "neovim"
        "wezterm"
		"uv"
    )

    for pkg in "${packages[@]}"; do
        if ! brew list "$pkg" &>/dev/null; then
            echo "Installing $pkg..."
            brew install "$pkg"
        fi
    done

    install_starship
    install_pynvim
    install_zshplugins
else
    echo "Homebrew not found! Please install it first."
fi

{{ else if and (eq .chezmoi.os "linux") .dev_computer -}}
# ========== LINUX (apt) ==========
echo "Detecting Linux... updating apt"
sudo apt-get update

# 1. Ripgrep
sudo apt-get install -y ripgrep

# 2. Neovim (using stable PPA for newer version)
sudo add-apt-repository ppa:neovim-ppa/stable -y
sudo apt-get update
sudo apt-get install -y neovim python3-pip

# 2.1 Install UV (python package manager)
sudo curl -LsSf https://astral.sh/uv/install.sh | sh

# 3. Lazygit (official install method for Ubuntu/Debian)
if ! command -v lazygit &> /dev/null; then
    LAZYGIT_VERSION=$(curl -s "https://api.github.com/repos/jesseduffield/lazygit/releases/latest" | grep -Po '"tag_name": "v\K[^"]*')
    curl -Lo lazygit.tar.gz "https://github.com/jesseduffield/lazygit/releases/latest/download/lazygit_${LAZYGIT_VERSION}_Linux_x86_64.tar.gz"
    tar xf lazygit.tar.gz lazygit
    sudo install lazygit /usr/local/bin
    rm lazygit lazygit.tar.gz
fi

# 4. WezTerm
if ! command -v wezterm &> /dev/null; then
    curl -fsSL https://apt.fury.io/wez/gpg.key | sudo gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg
    echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' | sudo tee /etc/apt/sources.list.d/wezterm.list
    sudo apt-get update
    sudo apt-get install -y wezterm
fi

# 5. Starship & Pynvim
install_starship
install_pynvim
install_zshplugins

{{ end -}}

echo "Installation complete!"
