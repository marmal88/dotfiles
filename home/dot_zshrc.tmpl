# Uncomment this line when profiling
# zmodload zsh/zprof

export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

# macOS Specific Homebrew & Ruby
{{ if and (.work) (eq .chezmoi.os "darwin") -}}
[[ -f /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
[[ -d /opt/homebrew/opt/ruby/bin ]] && export PATH="/opt/homebrew/opt/ruby/bin:$PATH"

# Work macOS WezTerm
[[ -d /Applications/WezTerm.app/Contents/MacOS ]] && export PATH="/Applications/WezTerm.app/Contents/MacOS:$PATH"
{{- end }}

bindkey -v
export KEYTIMEOUT=1 # Faster Vi-mode switching

# zsh plugin manager
ANTIDOTE_DIR="${ZDOTDIR:-$HOME}/.antidote"
PLUGINS_TXT="${ZDOTDIR:-$HOME}/.zsh_plugins.txt"

if [[ -f "$ANTIDOTE_DIR/antidote.zsh" ]]; then
    source "$ANTIDOTE_DIR/antidote.zsh"
    [[ -f "$PLUGINS_TXT" ]] && antidote load "$PLUGINS_TXT"
fi

# --- LAZY LOAD NVM (Node Version Manager) ---
export NVM_DIR="$HOME/.nvm"
if [[ -d "$NVM_DIR" ]]; then
    function nvm node npm npx {
      unfunction nvm node npm npx
      [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
      "$0" "$@"
    }
fi

# --- GO ENVIRONMENT ---
if command -v go >/dev/null 2>&1; then
    export GOPATH=$(go env GOPATH)
    export PATH="$PATH:$GOPATH/bin"
fi

# --- FZF CONFIGURATION ---
if command -v fzf >/dev/null 2>&1; then
    # Use "fzf --help" to check if the new "--zsh" flag exists
    if fzf --help | grep -q "--zsh" 2>/dev/null; then
        source <(fzf --zsh)
    else
        # Fallback for older versions
        # These are the standard paths for Debian/Ubuntu apt installs
        [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
        [ -f /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
        
        # Fallback for older Homebrew installs on Mac
        [ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh ] && source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
        [ -f /opt/homebrew/opt/fzf/shell/completion.zsh ] && source /opt/homebrew/opt/fzf/shell/completion.zsh
    fi
    
    export FZF_DEFAULT_OPTS="--height=60% --layout=reverse --info=inline --bind='ctrl-/:toggle-preview'"
fi

# --- STARSHIP ---
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"
    # Fix cursor issues with vi-mode
    if [[ "${widgets[zle-keymap-select]#user:}" == "starship_zle-keymap-select"* ]]; then
        zle -N zle-keymap-select ""
    fi
fi

# --- RIPGREP ---
[[ -f "$HOME/.config/ripgrep/config" ]] && export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

{{ template "work_settings.sh.tmpl" . }}
{{ template "shell_aliases.sh.tmpl" . }}

[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"
export PATH="$PATH:$HOME/bin"

# Uncomment this line when profiling 
# zprof
