#!/bin/sh

{{ if and (.dev_computer) (eq .osid "linux-debian" "linux-ubuntu") }}
echo "Installing wezterm..."
curl -fsSL https://apt.fury.io/wez/gpg.key | gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg
echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' | tee /etc/apt/sources.list.d/wezterm.list

{{ if eq .ephemeral}}
apt-get update && apt-get install -y wezterm
{{ else }}
sudo apt-get update && sudo apt-get install -y wezterm
{{end}}

echo "wezterm installed!"

{{- end -}}
