#!/bin/zsh

{{ if and (.dev_computer) ( eq .chezmoi.osid "linux-debian" ) -}}
if command -v apt-get &> /dev/null; then
    echo "apt-get found. Updating and installing packages."
    apt-get update

    # Generate the package list from data
    apt_packages=(
    {{- range .packages.apt }}
        {{ . | quote }}
    {{- end }}
    )

    if [ ${#apt_packages[@]} -gt 0 ]; then
        echo "Installing: ${apt_packages[*]}"
 		DEBIAN_FRONTEND=noninteractive apt-get install -y "${apt_packages[@]}"
    fi

    if ! command -v uv &> /dev/null; then
        echo "Installing uv..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
		source $HOME/.local/bin/env
    fi
else
    echo "apt-get not found. Skipping apt-related installations."
fi

{{ end -}}

echo "Installation complete! Run 'exec zsh' to start your new shell."
