#!/bin/sh

{{ if and (.dev_computer) ( eq .osid "linux-debian" "linux-ubuntu" ) -}}
if command -v apt-get &> /dev/null; then
    echo "apt-get found. Updating and installing packages."
    apt-get update

    # Generate the package list from data
    apt_packages=(
    {{- range .packages.apt }}
        {{ . | quote }}
    {{- end }}
    )

    if [ ${#apt_packages[@]} -gt 0 ]; then
        echo "Installing: ${apt_packages[*]}"
 	DEBIAN_FRONTEND=noninteractive apt-get install -y "${apt_packages[@]}"
        echo "--- Diagnostic: After apt-get install ---"
        echo "PATH: $PATH"
        command -v git || echo "git not found after apt install"
    fi

    if ! command -v uv &> /dev/null; then
        echo "Installing uv..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
 		source $HOME/.local/bin/env
        echo "--- Diagnostic: After uv install ---"
        echo "PATH: $PATH"
        command -v uv || echo "uv not found after uv install"
    fi
else
    echo "apt-get not found. Skipping apt-related installations."
fi

{{ end -}}

echo "Installation complete! Run 'exec zsh' to start your new shell."
