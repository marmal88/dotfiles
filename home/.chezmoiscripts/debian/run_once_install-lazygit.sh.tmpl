#!/bin/sh
set -e

{{ if and .dev_computer (eq .osid "linux-debian" "linux-ubuntu") }}
VERSION="{{ trimPrefix "v" (gitHubLatestRelease "jesseduffield/lazygit").TagName }}"

{{ if eq .chezmoi.arch "amd64" }}
ARCH="x86_64"
{{ else }}
ARCH="{{ .chezmoi.arch }}"
{{ end }}

echo "Installing Lazygit v${VERSION} for ${ARCH}..."
URL="https://github.com/jesseduffield/lazygit/releases/download/v${VERSION}/lazygit_${VERSION}_Linux_${ARCH}.tar.gz"

curl -Lo lazygit.tar.gz "$URL"
tar xf lazygit.tar.gz lazygit

{{ if .ephemeral }}
install lazygit /usr/local/bin
{{ else }}
sudo install lazygit /usr/local/bin
{{ end }}

rm lazygit lazygit.tar.gz
echo "Lazygit installed successfully!"
{{ end }}
