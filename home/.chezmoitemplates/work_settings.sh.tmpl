{{ if .work -}}
# GCLOUD
export GOOGLE_CLOUD_PROJECT = "dde-ops-data-science-d001"
export GOOGLE_CLOUD_LOCATION = "europe-west4"

# Certs
if [ -f "${HOME}/Certs/macOS-cacerts.pem" ]; then
    export SSL_CERT_FILE="${HOME}/Certs/macOS-cacerts.pem"
    export REQUESTS_CA_BUNDLE="${HOME}/Certs/macOS-cacerts.pem"
    export CURL_CA_BUNDLE="${HOME}/Certs/macOS-cacerts.pem"
fi

# 2. PySpark / Java
{{ if eq .chezmoi.os "darwin" -}}
# macOS Java Logic
if [ -x /usr/libexec/java_home ]; then
    export JAVA_HOME=$(/usr/libexec/java_home -v 17) 
    export PATH="/opt/homebrew/opt/openjdk@17/bin:$PATH"
fi

# Spark Home (only if brew and spark are installed)
if command -v brew >/dev/null 2>&1 && brew list apache-spark >/dev/null 2>&1; then
    export SPARK_HOME=$(brew --prefix apache-spark)/libexec
    export PATH="$SPARK_HOME/bin:$PATH"
fi
{{ else -}}
# Linux Java Logic (Example for Ubuntu/Debian)
if [ -d "/usr/lib/jvm/java-17-openjdk-amd64" ]; then
    export JAVA_HOME="/usr/lib/jvm/java-17-openjdk-amd64"
    export PATH="$JAVA_HOME/bin:$PATH"
fi
{{- end }}

# 3. Google Cloud SDK
{{ if eq .chezmoi.os "darwin" -}}
# macOS Homebrew GCloud Paths
GCLOUD_PATH="/opt/homebrew/share/google-cloud-sdk/path.zsh.inc"
GCLOUD_COMPLETION="/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc"

[ -f "$GCLOUD_PATH" ] && source "$GCLOUD_PATH"
[ -f "$GCLOUD_COMPLETION" ] && source "$GCLOUD_COMPLETION"
{{ else -}}
# Linux GCloud Paths (Usually installed via apt)
if [ -f "/usr/lib/google-cloud-sdk/path.zsh.inc" ]; then
    source "/usr/lib/google-cloud-sdk/path.zsh.inc"
    source "/usr/lib/google-cloud-sdk/completion.zsh.inc"
fi
{{- end }}

{{- end }}
